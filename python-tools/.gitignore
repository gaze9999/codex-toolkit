# Common Python, dependency and build rules are inherited from ../.gitignore
# Python tool-specific caches
*$py.class
/tiktoken-cache/

# Local runtimes and build inputs, including retained GUI build files
/src/gui/
/setup/runtime/
/.build-inputs/
/.workbench-ui/

# Additional test and proofreading output
junit*.xml
.textlintcache

# Local recovery files
*.bak

# Local tool output and recovery bundles
.bundle/
.gui/
.work-artifact-cleaner/
/.process-audit/

# Additional virtual environments
.venv-*/
