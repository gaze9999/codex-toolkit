# Share only the portable release workflow; keep other local automation private
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/cli-release.yml
!/.github/workflows/plugin-release.yml
!/.github/workflows/python-tools-release.yml
!/.github/workflows/check.yml
/.codex/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies / generated output
node_modules/
dist/
build/
coverage/
.cache/
.tmp/
tmp/
temp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

