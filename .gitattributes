# Check out text as LF so Windows builds hash the committed bytes; later rules override
* text=auto eol=lf
skills/document-production/scripts/validate_markdown.py text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
# Canonical Plugin sources and payload hashes must survive Git checkouts
skills/** text=auto eol=lf
plugins/** text=auto eol=lf
marketplace/** text=auto eol=lf
LICENSE text eol=lf

# Keep branding source hashes stable across platforms
assets/**/*.svg text eol=lf
assets/**/*.png -text
VERSION text eol=lf
.agents/plugins/marketplace.json text eol=lf
.claude-plugin/marketplace.json text eol=lf

# Preserve canonical Token Count resource hashes across platforms
python-tools/VERSION text eol=lf
python-tools/setup/requirements-token-count.txt text eol=lf
python-tools/src/shared/__init__.py text eol=lf
python-tools/src/shared/runtime.py text eol=lf
python-tools/src/text/__init__.py text eol=lf
python-tools/src/text/context_budget.py text eol=lf
python-tools/src/text/context_estimates.json text eol=lf
python-tools/src/text/token_count.py text eol=lf
python-tools/src/text/token_html.py text eol=lf

# Keep bundled development-core resource hashes stable across platforms
python-tools/packages/decisions/** text=auto eol=lf
python-tools/packages/visual-runtime/** text=auto eol=lf

# Publication hooks run through a POSIX shell on every platform
.githooks/* text eol=lf

# Plugin MCP runtime sources retain stable bytes across checkouts
mcp/pyproject.toml text eol=lf
mcp/LICENSE text eol=lf
mcp/mcp_servers/__init__.py text eol=lf
mcp/mcp_servers/local_documents/** text=auto eol=lf
mcp/mcp_servers/workspace_inspection/** text=auto eol=lf
mcp/mcp_servers/edge_devtools/** text=auto eol=lf
python-tools/pyproject.toml text eol=lf
python-tools/LICENSE text eol=lf
python-tools/docs/python-document-core.md text eol=lf
python-tools/src/my_py_document_core/** text=auto eol=lf
python-tools/src/documents/** text=auto eol=lf
python-tools/src/markdown/** text=auto eol=lf
python-tools/src/shared/** text=auto eol=lf
python-tools/packages/workspace_core/** text=auto eol=lf
